---
import BookOpen from "@lucide/astro/icons/book-open";
import Bookmark from "@lucide/astro/icons/bookmark";
import Building from "@lucide/astro/icons/building";
import Database from "@lucide/astro/icons/database";
import Globe from "@lucide/astro/icons/globe";
import Layers from "@lucide/astro/icons/layers";
import Library from "@lucide/astro/icons/library";
import Network from "@lucide/astro/icons/network";
import ShieldCheck from "@lucide/astro/icons/shield-check";
import Footer from "../components/Footer.astro";
import Seo from "../components/Seo.astro";
import SiteHeader from "../components/SiteHeader.astro";
import { strings } from "../i18n";
import { adds, asks, marketplace } from "../lib/marketplace";
import "../styles/global.css";

// The Marketplace's plugins by category, the most downloaded in calibre
// first, as the app's Marketplace shows them.
const icons: Record<string, typeof Globe> = {
  globe: Globe, library: Library, "book-open": BookOpen, database: Database,
  network: Network, building: Building, bookmark: Bookmark, layers: Layers,
};
const categories = marketplace.categories
  .map((c) => ({
    ...c,
    plugins: marketplace.plugins
      .filter((p) => p.category === c.id)
      .sort((a, b) => (b.downloads ?? 0) - (a.downloads ?? 0) || a.name.localeCompare(b.name)),
  }))
  .filter((c) => c.plugins.length);
const count = marketplace.plugins.length;

const en = strings("en").extend;
const builtins = [
  { name: "Project Gutenberg", kind: en.kindSource, text: en.builtins[0] },
  { name: "NeoDB", kind: en.kindMetadata, text: en.builtins[1] },
  { name: "Google Books", kind: en.kindMetadata, text: en.builtins[2] },
];

const title = "Plugins · Dalibre";
const description = `${count} plugins for Dalibre, from its Marketplace: calibre's most used plugins, ported, and the community's.`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <Seo title={title} description={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Geist+Mono:wght@400;500&family=Instrument+Serif:ital@0;1&family=Inter:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>

  <body class="font-sans">
    <div class="grain pointer-events-none fixed inset-0 z-50 opacity-70"></div>
    <SiteHeader current="plugins" />

    <main class="mx-auto max-w-6xl px-5">
      <section class="relative pt-20 pb-12 sm:pt-28">
        <div
          class="pointer-events-none absolute -top-24 left-0 -z-10 h-[360px] w-[640px] rounded-full opacity-60 blur-3xl"
          style="background: radial-gradient(closest-side, #ece7fd, transparent);"
        ></div>
        <p class="rise font-mono text-xs tracking-widest text-violet uppercase">Plugins</p>
        <h1 class="rise mt-4 max-w-3xl font-serif text-5xl leading-[1.05] tracking-tight sm:text-7xl">
          calibre's favourites, <em class="text-violet">ported.</em>
        </h1>
        <p class="rise mt-6 max-w-2xl leading-relaxed text-sand-11">
          {count} plugins in Dalibre's Marketplace: the most used calibre plugins, rewritten for Dalibre,
          and the community's. Install them in Dalibre from the toolbar's <strong class="font-medium text-ink">Plugins</strong>
          button › <strong class="font-medium text-ink">Marketplace</strong>. Each one shows what it may reach before you allow it.
        </p>
        <nav class="rise mt-8 flex flex-wrap gap-2" aria-label="Categories">
          {
            categories.map((c) => (
              <a
                href={`#${c.id}`}
                class="rounded-full border border-sand-6 px-3.5 py-1.5 text-sm text-sand-11 transition hover:border-sand-9 hover:text-ink"
              >
                {c.title} <span class="font-mono text-xs text-sand-9">{c.plugins.length}</span>
              </a>
            ))
          }
          <a
            href="#built-in"
            class="rounded-full border border-sand-6 px-3.5 py-1.5 text-sm text-sand-11 transition hover:border-sand-9 hover:text-ink"
          >
            Built in <span class="font-mono text-xs text-sand-9">{builtins.length}</span>
          </a>
        </nav>
      </section>

      {
        categories.map((c) => (
          <section id={c.id} class="scroll-mt-20 border-t border-sand-4 py-12">
            <h2 class="font-serif text-4xl tracking-tight">{c.title}</h2>
            <ul class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
              {c.plugins.map((p) => {
                const Icon = icons[p.icon ?? "globe"] ?? Globe;
                const source = p.homepage ?? (p.repo ? `https://github.com/${p.repo}` : undefined);
                return (
                  <li id={p.id} class="flex scroll-mt-20 flex-col rounded-2xl border border-sand-4 bg-paper-2 p-6">
                    <div class="flex items-start justify-between gap-3">
                      <div class="flex items-center gap-2.5">
                        <span class="grid size-8 shrink-0 place-items-center rounded-lg bg-violet/10 text-violet">
                          <Icon size={16} stroke-width={1.75} aria-hidden="true" />
                        </span>
                        <p class="font-medium leading-tight">{p.name}</p>
                      </div>
                      <span class="mt-0.5 shrink-0 font-mono text-[11px] text-sand-9">{p.version}</span>
                    </div>
                    {p.calibre && <p class="mt-3 font-mono text-[11px] text-sand-9">From calibre's {p.calibre}</p>}
                    <p class="mt-2 text-sm leading-relaxed text-sand-11">{p.description}</p>
                    <ul class="mt-4 flex flex-wrap gap-1.5">
                      {adds(p).map((a) => (
                        <li class="rounded-md border border-sand-4 bg-paper px-2 py-0.5 text-xs text-ink">{a}</li>
                      ))}
                    </ul>
                    <ul class="mt-4 space-y-1 text-xs text-sand-11">
                      {asks(p).map((a) => (
                        <li class="flex items-start gap-1.5">
                          <ShieldCheck size={13} stroke-width={1.75} class="mt-px shrink-0 text-green" aria-hidden="true" />
                          <span class="break-all">{a}</span>
                        </li>
                      ))}
                    </ul>
                    <div class="mt-auto flex items-center justify-between gap-3 pt-5 text-xs text-sand-9">
                      <span>{[p.author, p.license].filter(Boolean).join(" · ")}</span>
                      {source && (
                        <a href={source} target="_blank" rel="noopener" class="shrink-0 text-sand-11 transition hover:text-ink">
                          Source ↗
                        </a>
                      )}
                    </div>
                  </li>
                );
              })}
            </ul>
          </section>
        ))
      }

      <section id="built-in" class="scroll-mt-20 border-t border-sand-4 py-12">
        <h2 class="font-serif text-4xl tracking-tight">Built in</h2>
        <p class="mt-3 max-w-2xl text-sm leading-relaxed text-sand-11">Ship inside Dalibre, with nothing to install.</p>
        <ul class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {
            builtins.map((b) => (
              <li class="rounded-2xl border border-sand-4 bg-paper-2 p-6">
                <p class="font-mono text-[11px] text-sand-9">{b.kind}</p>
                <p class="mt-2 font-medium">{b.name}</p>
                <p class="mt-2 text-sm leading-relaxed text-sand-11">{b.text}</p>
              </li>
            ))
          }
        </ul>
      </section>

      <section class="mb-24 flex flex-col items-start justify-between gap-5 rounded-2xl border border-sand-6 bg-paper-2 px-7 py-8 sm:flex-row sm:items-center">
        <div>
          <p class="font-serif text-3xl leading-tight tracking-tight">Missing one? Write it.</p>
          <p class="mt-1 max-w-xl text-sm text-sand-11">
            A plugin is a <code class="font-mono text-[13px]">plugin.json</code> and a JavaScript file; your AI agent can
            write it for you. List yours with a pull request to the
            <a href="https://github.com/djyde/dalibre/blob/main/marketplace/README.md#list-your-plugin" target="_blank" rel="noopener" class="text-violet hover:underline">Marketplace</a>.
          </p>
        </div>
        <div class="flex shrink-0 flex-wrap gap-3">
          <a href="/docs/plugins/" class="rounded-full bg-ink px-5 py-2.5 text-sm font-medium text-paper transition hover:bg-black">Plugin docs</a>
          <a
            href="https://github.com/djyde/dalibre-plugin-template"
            target="_blank"
            rel="noopener"
            class="rounded-full border border-sand-6 px-5 py-2.5 text-sm font-medium transition hover:border-sand-9"
          >Template ↗</a>
        </div>
      </section>
    </main>

    <Footer />
  </body>
</html>
