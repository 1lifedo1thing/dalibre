{
  "$schema": "../../sdk/plugin.schema.json",
  "id": "dalibre.gutenberg",
  "name": "Project Gutenberg",
  "version": "1.0.0",
  "api": 1,
  "icon": "library",
  "description": "Over 70,000 free public-domain ebooks",
  "author": "Dalibre",
  "homepage": "https://www.gutenberg.org",
  "license": "MIT",
  "capabilities": {
    "bookSource": {
      "collections": true,
      "filters": [
        {
          "key": "language",
          "title": "Language",
          "type": "language",
          "options": [
            { "value": "", "title": "Any language" },
            { "value": "en" }, { "value": "fr" }, { "value": "de" }, { "value": "es" },
            { "value": "it" }, { "value": "pt" }, { "value": "nl" }, { "value": "fi" },
            { "value": "sv" }, { "value": "da" }, { "value": "no" }, { "value": "pl" },
            { "value": "ru" }, { "value": "el" }, { "value": "la" }, { "value": "zh" },
            { "value": "ja" }, { "value": "eo" }, { "value": "hu" }, { "value": "ca" }
          ]
        },
        {
          "key": "sort",
          "title": "Sort",
          "type": "select",
          "default": "popular",
          "options": [
            { "value": "popular", "title": "Most popular" },
            { "value": "new", "title": "Recently added" },
            { "value": "title", "title": "Title" }
          ]
        }
      ]
    }
  },
  "permissions": {
    "hosts": ["www.gutenberg.org"]
  }
}
