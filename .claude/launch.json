{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "site",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "site",
        "run",
        "dev",
        "--",
        "--port",
        "4321"
      ],
      "port": 4321
    },
    {
      "name": "site-dist",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "4330",
        "-d",
        "site/dist"
      ],
      "port": 4330
    },
    {
      "name": "site-dist-alt",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "4347",
        "-d",
        "site/dist"
      ],
      "port": 4347,
      "autoPort": false
    },
    {
      "name": "site-dist-3",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "4361",
        "-d",
        "site/dist"
      ],
      "port": 4361,
      "autoPort": false
    }
  ]
}
